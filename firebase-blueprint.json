{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information stored for authenticated users on successful login.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier matching request.auth.uid"
        },
        "name": {
          "type": "string",
          "description": "User's full name"
        },
        "email": {
          "type": "string",
          "description": "User's email address"
        },
        "profilePhoto": {
          "type": "string",
          "description": "User's profile photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user document was created"
        }
      },
      "required": ["uid", "name", "email", "createdAt"]
    }
  },
  "firestore": {
    "users/{uid}": {
      "schema": "User",
      "description": "Users collection containing personal profiles, keyed by uid"
    }
  }
}
